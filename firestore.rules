rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Allow reading and creating orders for store customers & admins
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Customers collection for account synchronization
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Blocked identifiers (phone/email blacklist)
    match /blocked_identifiers/{id} {
      allow read, write: if true;
    }

    // System settings including Telegram Bot configuration
    match /system_settings/{settingId} {
      allow read, write: if true;
    }

    // Landing page visual config & product catalog sync
    match /landing_config/{docId} {
      allow read, write: if true;
    }

    // Settings collection for landing page configuration & real-time builder persistence
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Uploaded videos and chunked sub-collections for cross-device streaming
    match /uploaded_videos/{videoId} {
      allow read, write: if true;
      match /chunks/{chunkId} {
        allow read, write: if true;
      }
    }

    // Fallback rule for any nested collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}


